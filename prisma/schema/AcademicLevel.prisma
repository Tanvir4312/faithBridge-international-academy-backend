model AcademicLevel {
  id          String  @id @default(uuid())
  name        String  @unique
  image       String?
  description String?
   createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?

  classes Class[]

  @@index([name])
  @@map("academicLevel")
}
