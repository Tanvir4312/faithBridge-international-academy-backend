model Exam {
  id              String    @id @default(uuid())
  name            String
  year            String
  formFillupStart DateTime
  formFillupEnd   DateTime
  examDate        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  results     Result[]
  formFillups FormFillup[]
  examResults ExamResult[]

  @@unique([name, year])
  @@index([year])
  @@index([name])
  @@map("exam")
}
